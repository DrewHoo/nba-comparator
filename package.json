{
  "name": "nba-comparator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run records && vite build && node scripts/prerender.mjs",
    "records": "node --max-old-space-size=6144 scripts/build-records.mjs",
    "preview": "vite preview",
    "fetch": "node scripts/fetch-hoopr.mjs",
    "fetch:history": "node scripts/fetch-history.mjs",
    "history": "node --max-old-space-size=6144 scripts/build-history.mjs",
    "ledger": "node --max-old-space-size=6144 scripts/build-ledger.mjs",
    "gate": "node scripts/gate.mjs",
    "gen:og": "node scripts/gen-og.mjs",
    "gen:favicon": "node scripts/gen-favicon.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p . && tsc -p workers/share",
    "typecheck:worker": "tsc -p workers/share",
    "worker:dev": "npx wrangler dev -c workers/share/wrangler.jsonc --local --var ORIGIN:http://localhost:4174 --var NO_REPORT:1",
    "worker:deploy": "npx wrangler deploy -c workers/share/wrangler.jsonc"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^29.1.1",
    "opentype.js": "^1.3.4",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^5.0.2",
    "workers-og": "^0.0.27",
    "wrangler": "4.151.3"
  }
}
