{
  // The share worker: per-board <head> rewrites and og cards in front of
  // GitHub Pages. Deploy with: npx wrangler deploy -c workers/share/wrangler.jsonc
  "name": "nba-comparator-share",
  "main": "index.ts",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "drewhoover.com/nba-comparator/*", "zone_name": "drewhoover.com" }],
  "workers_dev": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // the card's fonts ride in the bundle; resvg's wasm imports as a module
  "rules": [{ "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }]
}
